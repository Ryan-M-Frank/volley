#!/usr/bin/env bash
# Fake `codex` for offline tests of scripts/codex-exec.sh. Records argv, stdin and cwd per call
# (call N writes $FAKE_CODEX_DIR/args.N etc.), emits a minimal --json event stream and writes the
# -o file. Knobs: FAKE_CODEX_THREAD, FAKE_CODEX_EXIT, FAKE_CODEX_FAIL_RESUME=1, FAKE_CODEX_NO_OUT=1.
dir="${FAKE_CODEX_DIR:?FAKE_CODEX_DIR not set}"
n=$(( $(cat "$dir/calls" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$dir/calls"
printf '%s\n' "$@" > "$dir/args.$n"
pwd > "$dir/pwd.$n"
cat > "$dir/stdin.$n"
out=""; prev=""
for a in "$@"; do [ "$prev" = "-o" ] && out="$a"; prev="$a"; done
if [ "${FAKE_CODEX_FAIL_RESUME:-}" = "1" ] && [ "${2:-}" = "resume" ]; then
  echo "Error: no session found with that id" >&2; exit 1
fi
echo '{"type":"thread.started","thread_id":"'"${FAKE_CODEX_THREAD:-11111111-2222-3333-4444-555555555555}"'"}'
echo '{"type":"turn.completed"}'
if [ -n "$out" ] && [ "${FAKE_CODEX_NO_OUT:-}" != "1" ]; then echo "REVIEW BODY" > "$out"; fi
exit "${FAKE_CODEX_EXIT:-0}"
